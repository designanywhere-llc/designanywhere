# Resend API key — required for POST /api/contact to send email.
# Create one at https://resend.com (never commit the real value).
RESEND_API_KEY=

# From address. Default in code is the Resend sandbox sender:
#   Design Anywhere <onboarding@resend.dev>
# After verifying designanywhere.org in Resend, switch to:
#   Design Anywhere <leads@designanywhere.org>
CONTACT_FROM_EMAIL=Design Anywhere <onboarding@resend.dev>

# Recipients (defaults shown; override only if needed)
CONTACT_TO_EMAIL=engineering@designanywhere.org
CONTACT_BCC_EMAIL=jordanbell@designanywhere.org

# Optional. Replit / production set this automatically.
# PORT=5000
