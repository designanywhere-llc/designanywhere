# Lead API (Vercel project root: services/lead-api, host api.designanywhere.org).
# GitHub Pages does not read these. Never commit real secret values.
#
# Create a Resend key at https://resend.com.
RESEND_API_KEY=

# From address. Default in the lead API:
#   Design Anywhere <leads@contact.designanywhere.org>
# contact.designanywhere.org is the verified Resend sending domain.
CONTACT_FROM_EMAIL=Design Anywhere <leads@contact.designanywhere.org>

# Recipients (defaults shown; override only if needed)
CONTACT_TO_EMAIL=engineering@designanywhere.org
CONTACT_BCC_EMAIL=jordanbell@designanywhere.org

# Comma-separated browser origins allowed to call POST /api/lead.
# Default when unset: https://designanywhere.org,https://www.designanywhere.org
# http://localhost:5173 is also allowed when NODE_ENV is not production.
CONTACT_ALLOWED_ORIGIN=https://designanywhere.org,https://www.designanywhere.org

# Injected by Vercel when a Blob store is connected to the project.
# Required for `npm run leads:list`. Do not invent a value.
BLOB_READ_WRITE_TOKEN=

# Optional. The legacy local Express server sets this automatically.
# PORT=5000
